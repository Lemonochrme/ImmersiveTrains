{
  "schemaVersion": 1,
  "id": "immersive_trains",
  "version": "${version}",
  "name": "Immersive Trains",
  "description": "A bunch of vanilla-friendly trains to travel, transport, and explore!\n",
  "authors": [
    "Lemonochrme"
  ],
  "contact": {
    "homepage": "https://github.com/Lemonochrme/ImmersiveTrains",
    "sources": "https://github.com/Lemonochrme/ImmersiveTrains",
    "issues": "https://github.com/Lemonochrme/ImmersiveTrains/issues"
  },
  "license": "GPL-3.0-only",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "immersive_trains.fabric.CommonFabric"
    ],
    "client": [
      "immersive_trains.fabric.ClientFabric"
    ],
    "modmenu": [
      "immersive_trains.config.ModMenuIntegration"
    ],
    "jei_mod_plugin": [
      "immersive_trains.combat.JEICCombat"
    ],
    "rei_client": [
      "immersive_trains.combat.REICombat"
    ]
  },
  "mixins": [
    "immersive_trains.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.11.3",
    "java": ">=21",
    "fabric-api-base": ">=0.1.0"
  },
  "breaks": {
    "ad_astra": "<1.15.6"
  }
}
